# Copy this file to .env and fill in values for local development.
# Never commit the real .env file — it is gitignored.

# The three vars below are the single source of truth for the Postgres
# credentials/db name — docker-compose.yml's `postgres` service reads them
# directly, and interpolates them into the `migrate`/`web` services'
# DATABASE_URL, instead of the same values being hardcoded in four places.
# Change them here and every service picks it up automatically.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="product_content_studio"

# PostgreSQL connection string for connecting from the host machine (e.g.
# `npm run dev`, `npx prisma migrate dev`) — must use `localhost`, unlike the
# Docker Compose services above which reach Postgres via its network
# hostname. Keep the user/password/db name in sync with the three vars
# above if you change them (plain `dotenv` doesn't expand `${...}` inside
# .env values, so this can't just reference them directly).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_content_studio?schema=public"

# JWT secrets for the access+refresh token auth pattern (see AGENTS.md).
# Use long, random values — e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"

# Optional — override the seeded test admin's credentials (see `npm run seed`).
# Defaults to admin@example.com / admin12345 if left unset.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional — only required to exercise the real (non-mocked) LLM bonus feature.
# Leave unset to use the mocked/simulated response mode.
OPENAI_API_KEY=""

# Optional — only required for the Shopify import bonus feature.
SHOPIFY_STORE_DOMAIN=""

# Two ways to authenticate — set ONE of these, not both:
# 1. SHOPIFY_ADMIN_API_TOKEN — a static token, only available for a
#    "legacy" custom app created before Shopify's 2026-01-01 change.
# 2. SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET — the current Dev Dashboard
#    flow (https://dev.shopify.com/dashboard). The app exchanges these for
#    a short-lived access token itself and refreshes it automatically —
#    see src/server/services/shopify/token-provider.ts.
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

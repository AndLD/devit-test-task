{
  "name": "product-content-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node-version.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preseed": "npm run check-node",
    "seed": "prisma db seed",
    "test": "npm run test:unit && npm run test:integration && npm run test:frontend",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects integration --runInBand",
    "test:frontend": "npm run test:frontend-unit && npm run test:frontend-integration",
    "test:frontend-unit": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects frontend-unit",
    "test:frontend-integration": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects frontend-integration",
    "pretest:e2e": "npm run seed",
    "test:e2e": "start-server-and-test 'npm run dev' http://localhost:3000 'cypress run'",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.9.7",
    "prisma": "7.10.0",
    "shadcn": "^4.21.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
